ENVIRONMENT=development
# development: local testing; pilot/study: assessment preview disabled.
# This labels NEW records, not research approval. Keep each cohort in one mode.
LEAP_COLLECTION_MODE=development
FRONTEND_ORIGINS=http://localhost:3000
TUTOR_LLM_PROVIDER=ollama
OLLAMA_CHAT_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=180
# OpenRouter is a public OpenAI-compatible LLM gateway for lesson generation.
# TUTOR_LLM_PROVIDER=openrouter
# OPENROUTER_CHAT_URL=https://openrouter.ai/api/v1/chat/completions
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key
# OPENROUTER_TIMEOUT_SECONDS=180
# OPENROUTER_MAX_TOKENS=4096
WORLD_MODEL_SERVICE_URL=http://127.0.0.1:8001
WORLD_MODEL_TIMEOUT_SECONDS=30
# Required in production and shared with the private model service.
WORLD_MODEL_SERVICE_TOKEN=replace-with-a-long-random-secret
CODAPI_URL=https://api.codapi.org/v1/exec
CODAPI_SANDBOX=python
CODAPI_TIMEOUT_SECONDS=20
# Optional for Codapi Cloud subscriptions or a protected self-hosted instance.
CODAPI_TOKEN=
# Production only. Neon supplies this value and requires TLS.
DATABASE_URL=postgresql://user:password@hostname/database?sslmode=require
CODE_EXECUTION_ENGINE=docker
CODE_EXECUTION_DOCKER_IMAGE=leap-python-runtime:latest
CODE_EXECUTION_TIMEOUT_SECONDS=30
