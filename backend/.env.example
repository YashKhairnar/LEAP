ENVIRONMENT=development
# development: local testing; pilot/study: assessment preview disabled.
# This labels NEW records, not research approval. Keep each cohort in one mode.
LEAP_COLLECTION_MODE=development
FRONTEND_ORIGINS=http://localhost:3000
# Lesson and question content is authored in app/tutoring/authored_content.py.
WORLD_MODEL_SERVICE_URL=http://127.0.0.1:8001
WORLD_MODEL_ENABLED=false
WORLD_MODEL_TIMEOUT_SECONDS=30
# Required in production and shared with the private model service.
WORLD_MODEL_SERVICE_TOKEN=replace-with-a-long-random-secret
# Hosted Modal sandbox service.
CODE_EXECUTION_ENGINE=modal
MODAL_SANDBOX_URL=https://your-modal-endpoint.modal.run
MODAL_SANDBOX_TOKEN=replace-with-the-shared-sandbox-token
MODAL_SANDBOX_TIMEOUT_SECONDS=50
# Production only. Neon supplies this value and requires TLS.
DATABASE_URL=postgresql://user:password@hostname/database?sslmode=require
# Local alternative: CODE_EXECUTION_ENGINE=docker
CODE_EXECUTION_DOCKER_IMAGE=leap-python-runtime:latest
CODE_EXECUTION_TIMEOUT_SECONDS=30
# Maximum CSV payload sent to hosted code execution; previews still use the full dataset.
CODE_EXECUTION_MAX_DATASET_BYTES=12000
